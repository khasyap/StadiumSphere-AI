{
  "name": "@stadiumsphere/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "pnpm run build && pnpm run start",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
